# Production environment for docker-compose.prod.yml.
# Copy to ".env" on the server and fill in. NEVER commit the real .env.
#   cp .env.prod.example .env && chmod 600 .env

SPRING_PROFILES_ACTIVE=prod

# Database (the "db" container; not exposed outside the compose network)
POSTGRES_DB=fitness_uplink
POSTGRES_USER=fitness
# openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# Secrets
# openssl rand -hex 48 (>= 64 bytes)
JWT_SECRET=CHANGE_ME
# openssl rand -hex 32
SIGNATURE_WEBHOOK_SECRET=CHANGE_ME

# First administrator account created at startup
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=CHANGE_ME

# Public address of the site (no trailing slash): http://<IP> now, https://<domain> later
FRONTEND_URL=http://CHANGE_ME
CORS_ALLOWED_ORIGINS=http://CHANGE_ME

# Refresh-token cookie. "false" ONLY while serving over plain HTTP (IP phase). Remove / set true with HTTPS.
COOKIE_SECURE=false

# SMTP (Gmail app password). Leave empty to disable e-mail sending.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# reCAPTCHA v3: leave both empty while using an IP address (Google does not accept IPs).
# VITE_RECAPTCHA_SITE_KEY is public and baked into the frontend at build time.
RECAPTCHA_SECRET=
VITE_RECAPTCHA_SITE_KEY=
